config LED_STRIP_COMPOSITE
    bool "Composite RGB LED strip"
    default y
    depends on DT_HAS_ZMK_LED_STRIP_COMPOSITE_ENABLED
    select LED_STRIP
    help
      Concatenates the devices referenced by a zmk,led-strip-composite node
      into one RGB LED strip. Available independently of the RGB matrix.

config LED_STRIP_COMPOSITE_INIT_PRIORITY
    int "Composite LED strip initialization priority"
    default 91
    range 0 99
    depends on LED_STRIP_COMPOSITE
    help
      POST_KERNEL-level initialization priority. Child devices must initialize
      earlier and consumers later. Nested composites at the same priority are
      ordered by devicetree dependencies on Zephyr 4.1.

config KEYPAW_RGB_MATRIX
    bool "Keypaw position-aware RGB matrix"
    default y
    depends on DT_HAS_KEYPAW_RGB_MATRIX_ENABLED
    select LED_STRIP
    help
      Drives an RGB LED strip with per-key, position-aware effects. The LED
      geometry (leds/mapping) comes from the keypaw,rgb-matrix devicetree
      node and the strip itself from its "strip" phandle.

if KEYPAW_RGB_MATRIX

config KEYPAW_RGB_WORKQUEUE_STACK_SIZE
    int "RGB matrix work queue stack size"
    default 2048
    range 1024 8192
    help
      Stack for the module's dedicated low-priority work queue, which runs all
      engine work: render passes, condition and trigger evaluation, split sync
      and the settings reset. Size it for the deepest chain, not just rendering:
      a fired trigger invokes a selector control, which on the split central
      reaches the BLE transport. Keep it above the observed high-water mark with
      margin.

config KEYPAW_RGB_WORKQUEUE_PRIORITY
    int "RGB matrix work queue thread priority"
    default 10
    help
      Priority of the module's work queue thread. The default matches ZMK's
      low-priority work queue so RGB work never preempts typing.

config KEYPAW_RGB_MATRIX_TICK_MS
    int "Animation tick period (ms)"
    default 32
    range 1 1000
    help
      Upstream underglow uses 50 ms; 32 ms is noticeably smoother for the
      reactive and ripple effects. One update costs ~1.5 ms of blocking SPI.

config KEYPAW_RGB_MATRIX_HUE_STEP
    int "Hue adjustment step"
    default 10

config KEYPAW_RGB_MATRIX_SAT_STEP
    int "Saturation adjustment step"
    default 10

config KEYPAW_RGB_MATRIX_BRT_STEP
    int "Brightness adjustment step"
    default 10

config KEYPAW_RGB_MATRIX_DURATION_STEP
    int "Duration adjustment step (ms)"
    default 100
    help
      Animation "speed" is expressed as a period: a shorter duration animates
      faster. This is added to (or subtracted from) the active effect's period
      by the Duration Up/Down commands. An additive step is used because the
      relative press is resolved to an absolute value on the split central, and
      adding is exact regardless of the current period.

config KEYPAW_RGB_MATRIX_DURATION_MIN_MS
    int "Fastest animation period (ms)"
    default 100
    range 1 60000

config KEYPAW_RGB_MATRIX_DURATION_MAX_MS
    int "Slowest animation period (ms)"
    default 10000
    range 1 60000

# Caps Lock will pull in a HID-indicator event dependency. Disable it if you
# don't need that.
config KEYPAW_RGB_CONDITION_CAPS_LOCK
    bool
    default y
    depends on DT_HAS_KEYPAW_RGB_CONDITION_CAPS_LOCK_ENABLED
    select ZMK_HID_INDICATORS
    help
      Caps Lock condition. Enabled by the presence of a
      keypaw,rgb-condition-caps-lock node. Selects ZMK_HID_INDICATORS, which is
      what the host sets when Caps Lock is on.

# BLE host-profile state exists only on the central, so the condition reads it
# there and returns false on a peripheral.
config KEYPAW_RGB_CONDITION_BLE
    bool
    default y
    depends on DT_HAS_KEYPAW_RGB_CONDITION_BLE_ENABLED
    help
      Bluetooth profile condition. Enabled by the presence of a
      keypaw,rgb-condition-ble node. Matches the active profile index and
      connection state; a build without Bluetooth compiles the condition to a
      constant false.

endif # KEYPAW_RGB_MATRIX

config KEYPAW_RGB_TRIGGERS
    bool "RGB matrix trigger table"
    default y
    depends on KEYPAW_RGB_MATRIX
    depends on DT_HAS_KEYPAW_RGB_TRIGGER_TABLE_ENABLED
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
    help
      Edge-triggered condition -> RGB command rules, declared as the children of
      a keypaw,rgb-trigger-table node (their declaration order is the firing
      order). Each rule runs its `on-enter` when its condition becomes active and
      its `on-exit` when it clears; rules are independent, so none shadows
      another. Each trigger references a reusable keypaw,rgb-condition-* node.

      Built for the split central only: a trigger's condition may read keymap
      state, which does not exist on a peripheral. The commands still reach both
      halves because the behavior is BEHAVIOR_LOCALITY_GLOBAL.

config KEYPAW_RGB_SPLIT_SYNC
    bool "Push the RGB state to a split peripheral when it connects"
    default y
    depends on KEYPAW_RGB_MATRIX
    depends on ZMK_SPLIT && ZMK_SPLIT_ROLE_CENTRAL
    help
      Reconnect and transport changes replay global user power, brightness,
      synchronized overlay gates and every controlled composition's member
      colors, periods and selection, including inactive members. Overlapping
      converted invocations and failed converted callbacks request repair when
      their invocation group finishes. Ordinary isolated successful commands,
      direct callbacks and local APIs do not request repair.

      Each attempt samples current state. Replay repeats until generation is
      unchanged and no converted invocation remains outstanding. Successful
      state sends are paced 50 ms apart; observed failures retry that peripheral
      after 1 second without blocking other peripherals or clock correction.

      Built for the split central only; control remains live while output is
      off, inhibited, hidden or has no local LEDs. Both halves must use matching
      canonical behavior names and member slots. Transport success means local
      acceptance, not acknowledged delivery or an atomic scene transaction.
      The keypaw,rgb-matrix node is the global endpoint on both halves for
      power, brightness, overlay gates and shared-clock commands, even when
      no selectors are configured.

if KEYPAW_RGB_SPLIT_SYNC

config KEYPAW_RGB_SPLIT_SYNC_POLL_MS
    int "Peripheral connection poll period (ms)"
    default 1000
    range 1 60000
    help
      How often the connected-source set is sampled without radio traffic.
      Disconnects shorter than this period may be missed. Observed reconnects
      and transport changes request full replay after the settle delay.

config KEYPAW_RGB_SPLIT_SYNC_SETTLE_MS
    int "Delay before pushing to a newly connected peripheral (ms)"
    default 1000
    range 1 60000
    help
      A peripheral is marked connected before its GATT characteristics have been
      discovered, and the split worker drops a command sent in that window with
      "Run behavior handle not found" without reporting it back to the sender.
      Waiting this long after the connection is seen gives discovery and the
      security upgrade time to finish. Best effort, not a guarantee.

config KEYPAW_RGB_SPLIT_SYNC_CLOCK_MS
    int "Shared animation clock re-sync period (ms)"
    default 30000
    range 1000 60000
    help
      How often the central re-sends its monotonic uptime so a peripheral
      corrects crystal drift in its shared animation-clock offset. Runs
      independently of the connection poll; an early drop self-heals on the
      next period.

endif # KEYPAW_RGB_SPLIT_SYNC
