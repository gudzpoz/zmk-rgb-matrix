 *
 * Minimal 4x12 keymap for the preview harness. The module animates on its own
 * and the harness picks the effect with --effect, so no binding needs to invoke
 * &kprgb: a layer of &none is enough to satisfy ZMK.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };
    };
};
