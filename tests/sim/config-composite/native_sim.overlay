#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/common/ortho_4x12/all1u.dtsi>

/ {
    chosen {
        zmk,physical-layout = &layout_ortho_4x12_all1u;
    };

    default_transform: keymap-transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
            RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5)
            RC(0, 6) RC(0, 7) RC(0, 8) RC(0, 9) RC(0, 10) RC(0, 11)
            RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5)
            RC(1, 6) RC(1, 7) RC(1, 8) RC(1, 9) RC(1, 10) RC(1, 11)
            RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5)
            RC(2, 6) RC(2, 7) RC(2, 8) RC(2, 9) RC(2, 10) RC(2, 11)
            RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5)
            RC(3, 6) RC(3, 7) RC(3, 8) RC(3, 9) RC(3, 10) RC(3, 11)
        >;
    };

    probe_keys: probe-keys {
        compatible = "keypaw,led-strip-composite-probe";
        chain-length = <2>;
    };

    probe_glow: probe-glow {
        compatible = "keypaw,led-strip-composite-probe";
        chain-length = <3>;
    };

    nested_output: nested-output {
        compatible = "zmk,led-strip-composite";
        strips = <&probe_glow>;
        chain-length = <3>;
    };

    rgb_output: rgb-output {
        compatible = "zmk,led-strip-composite";
        strips = <&probe_keys &nested_output>;
        chain-length = <5>;
    };

    rgb_matrix: rgb-matrix {
        compatible = "keypaw,rgb-matrix";
        strip = <&rgb_output>;
        physical-layout = <&layout_ortho_4x12_all1u>;
        mapping = <11 4 27 9 36>;
    };

    behaviors {
        kprgb: kprgb {
            compatible = "keypaw,behavior-rgb-matrix";
            #binding-cells = <2>;
            initial-on;
            initial-brightness = <100>;
            max-brightness = <100>;
            idle-brightness = <100>;

            fx_static: fx-static {
                compatible = "keypaw,rgb-matrix-static";
                #binding-cells = <0>;
                led-colors = <0x102030 0x405060 0x708090 0xa0b0c0 0xd0e0f0>;
            };
        };
    };
};

&layout_ortho_4x12_all1u {
    transform = <&default_transform>;
};

&kscan {
    rows = <4>;
    columns = <12>;
    events = <>;
    /delete-property/ exit-after;
};
